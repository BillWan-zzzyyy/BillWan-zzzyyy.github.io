---
---
{%- comment -%}
  One publication entry (jekyll-scholar bibliography_template), four lines
  beside a thumbnail: title (links to the project page, else the paper),
  authors, "<full venue>, <year>", and a row of text links preceded by an
  optional bold `highlight` phrase (e.g. highlight={Best Paper Award}).
  Fields such as summary, abbr, abstract and bibtex_show stay in papers.bib
  but are not rendered. Styles live in _sass/_publications.scss.
{%- endcomment -%}
{% assign has_media = false %}
{% if site.enable_publication_thumbnails and entry.preview %}
  {% assign has_media = true %}
{% endif %}
<div class="pub-entry{% if has_media %} pub-entry--with-media{% endif %}">
  {% if has_media %}
    <div class="pub-entry__media">
      {% if entry.preview contains '://' %}
        <img class="pub-entry__thumb" src="{{ entry.preview }}" loading="lazy" decoding="async" alt="{{ entry.title | strip_html | escape }}">
      {% else %}
        {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        {% assign still_path = entry.preview | prepend: '/assets/img/publication_preview/still/' %}
        {% capture has_still %}{% file_exists {{ still_path }} %}{% endcapture %}
        {% unless has_still == 'true' %}{% assign still_path = null %}{% endunless %}
        {%
          include figure.liquid
          loading="lazy"
          path=entry_path
          reduced_motion_path=still_path
          sizes="(min-width: 768px) 240px, 360px"
          class="pub-entry__thumb"
          zoomable=true
          alt=entry.title
        %}
      {% endif %}
    </div>
  {% endif %}

  <div id="{{ entry.key }}" class="pub-entry__body">
    {%- comment -%} "Paper" target: html → arXiv → PDF → DOI. {%- endcomment -%}
    {% assign paper_url = null %}
    {% if entry.html %}
      {% if entry.html contains '://' %}
        {% assign paper_url = entry.html %}
      {% else %}
        {% assign paper_url = entry.html | prepend: '/assets/html/' | relative_url %}
      {% endif %}
    {% elsif entry.arxiv %}
      {% assign paper_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
    {% elsif entry.pdf %}
      {% if entry.pdf contains '://' %}
        {% assign paper_url = entry.pdf %}
      {% else %}
        {% assign paper_url = entry.pdf | prepend: '/assets/pdf/' | relative_url %}
      {% endif %}
    {% elsif entry.doi %}
      {% assign paper_url = entry.doi | prepend: 'https://doi.org/' %}
    {% endif %}
    {% assign title_url = paper_url %}
    {% if entry.website %}
      {% assign title_url = entry.website %}
    {% endif %}
    <h3 class="pub-entry__title">
      {% if title_url %}
        <a href="{{ title_url }}">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </h3>

    <!-- Author -->
    <div class="pub-entry__authors">
      {% assign author_array_size = entry.author_array | size %}

      {% assign author_array_limit = author_array_size %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign author_array_limit = site.max_author_limit %}
        {%- comment -%}
          Never hide the site owner or a co-first author: extend the visible list up to the owner's
          position and through the leading run of co-first authors (last names marked with * or ∗).
        {%- endcomment -%}
        {% assign cofirst_run = true %}
        {% for author in entry.author_array %}
          {% assign limit_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' %}
          {% if site.scholar.last_name contains limit_last_name and site.scholar.first_name contains author.first %}
            {% if forloop.index > author_array_limit %}
              {% assign author_array_limit = forloop.index %}
            {% endif %}
          {% endif %}
          {% if cofirst_run %}
            {% if author.last contains '*' or author.last contains '∗' %}
              {% if forloop.index > author_array_limit %}
                {% assign author_array_limit = forloop.index %}
              {% endif %}
            {% else %}
              {% assign cofirst_run = false %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {%- for author in entry.author_array limit: author_array_limit -%}
        {% assign author_is_self = false %}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {% if site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign author_is_self = true %}
          {% endif %}
        {%- endif -%}
        {% assign coauthor_url = null %}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {% if site.data.coauthors[clean_last_name] %}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {% if coauthor.firstname contains author.first %}
              {%- assign coauthor_url = coauthor.url -%}
              {% break %}
            {% endif %}
          {% endfor %}
        {%- endif -%}

        {%- if forloop.length > 1 -%}
          {% if forloop.first == false %},&nbsp;{% endif %}
          {%- if forloop.last and author_array_limit == author_array_size %}and&nbsp;{% endif -%}
        {% endif %}
        {%- if author_is_self -%}
          <strong class="author-self">
            {{- author.first }}
            {{ author_last_html -}}
          </strong>
        {%- else -%}
          {%- if coauthor_url -%}
            <a href="{{ coauthor_url }}">
              {{- author.first }}
              {{ author_last_html -}}
            </a>
          {%- else -%}
            {{- author.first }}
            {{ author_last_html -}}
          {% endif %}
        {%- endif -%}
      {% endfor %}
      {%- assign more_authors = author_array_size | minus: author_array_limit -%}

      {%- assign more_authors_hide = more_authors | append: ' more author' -%}
      {% if more_authors > 0 %}
        {%- if more_authors > 1 -%}
          {% assign more_authors_hide = more_authors_hide | append: 's' %}
        {%- endif -%}
        {%- comment -%} Hidden authors as HTML, so the self name stays bold once expanded. {%- endcomment -%}
        {% assign more_authors_show = '' %}
        {%- for author in entry.author_array offset: author_array_limit -%}
          {%- assign hidden_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
          {%- capture hidden_name -%}
            {{- author.first }} {{ author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -}}
          {%- endcapture -%}
          {%- if site.scholar.last_name contains hidden_last_name and site.scholar.first_name contains author.first -%}
            {%- capture hidden_name -%}<strong class="author-self">{{ hidden_name }}</strong>{%- endcapture -%}
          {%- endif -%}
          {% assign more_authors_show = more_authors_show | append: hidden_name %}
          {% unless forloop.last %}
            {% assign more_authors_show = more_authors_show | append: ', ' %}
          {% endunless %}
        {%- endfor -%}
        , and
        <button
          type="button"
          class="more-authors"
          title="Show {{ more_authors_hide }}"
          aria-expanded="false"
          data-collapsed-text="{{ more_authors_hide | escape }}"
          data-expanded-html="{{ more_authors_show | escape }}"
        >
          {{- more_authors_hide -}}
        </button>
      {% endif %}
      {% if entry.annotation %}
        <i
          class="fa-solid fa-circle-info pub-entry__annotation"
          data-toggle="popover"
          data-placement="top"
          data-html="true"
          data-content="{{ entry.annotation | escape }}"
        >
        </i>
      {% endif %}
    </div>

    <!-- Full venue name, year -->
    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
    {% assign entrytype = '' %}
    {% if entry.type == 'article' %}
      {% assign entrytype = entry.journal %}
    {% elsif proceedings contains entry.type %}
      {% assign entrytype = entry.booktitle %}
    {% elsif thesis contains entry.type %}
      {% assign entrytype = entry.school %}
    {% endif %}
    {% capture hook_exists %}{% file_exists _includes/hook/bib.liquid %}{% endcapture %}
    {% if hook_exists == 'true' %}
      {% include hook/bib.liquid %}
    {% endif %}
    {% assign entrytype_text = entrytype | strip_html | strip %}
    {% assign entryyear = entry.year | strip %}
    {% if entrytype_text != '' or entryyear != '' %}
      <div class="pub-entry__venue">
        {{- entrytype_text -}}
        {%- if entrytype_text != '' and entryyear != '' %}, {% endif -%}
        {{- entryyear -}}
      </div>
    {% endif %}

    {%- comment -%}
      Optional bold `highlight` phrase, then text links joined by a spaced
      bullet, only for fields that exist: Paper, Project, Code, Video, PDF
      (when distinct from Paper), then Slides, Poster, Supp, Blog. The video
      toggle button (enable_video_embedding) must stay a direct child of this
      row: assets/js/common.js looks for its panel in control.parent().parent().
    {%- endcomment -%}
    {% assign pub_links = '' | split: '' %}
    {% if entry.highlight %}
      {% capture pub_link %}<strong class="pub-entry__highlight">{{ entry.highlight }}</strong>{% endcapture %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if paper_url %}
      {% capture pub_link %}<a href="{{ paper_url }}">Paper</a>{% endcapture %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if entry.website %}
      {% capture pub_link %}<a href="{{ entry.website }}">Project</a>{% endcapture %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if entry.code %}
      {% capture pub_link %}<a href="{{ entry.code }}">Code</a>{% endcapture %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% elsif entry.github_repo %}
      {% capture pub_link %}<a href="https://github.com/{{ entry.github_repo }}">Code</a>{% endcapture %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if entry.video %}
      {% if site.enable_video_embedding %}
        {% capture pub_link %}<button type="button" class="abstract" aria-expanded="false">Video</button>{% endcapture %}
      {% else %}
        {% capture pub_link %}<a href="{{ entry.video }}">Video</a>{% endcapture %}
      {% endif %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if entry.pdf %}
      {% if entry.pdf contains '://' %}
        {% assign pdf_url = entry.pdf %}
      {% else %}
        {% assign pdf_url = entry.pdf | prepend: '/assets/pdf/' | relative_url %}
      {% endif %}
      {% if pdf_url != paper_url %}
        {% capture pub_link %}<a href="{{ pdf_url }}">PDF</a>{% endcapture %}
        {% assign pub_links = pub_links | push: pub_link %}
      {% endif %}
    {% endif %}
    {% if entry.slides %}
      {% if entry.slides contains '://' %}
        {% capture pub_link %}<a href="{{ entry.slides }}">Slides</a>{% endcapture %}
      {% else %}
        {% capture pub_link %}<a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}">Slides</a>{% endcapture %}
      {% endif %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if entry.poster %}
      {% if entry.poster contains '://' %}
        {% capture pub_link %}<a href="{{ entry.poster }}">Poster</a>{% endcapture %}
      {% else %}
        {% capture pub_link %}<a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}">Poster</a>{% endcapture %}
      {% endif %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if entry.supp %}
      {% if entry.supp contains '://' %}
        {% capture pub_link %}<a href="{{ entry.supp }}">Supp</a>{% endcapture %}
      {% else %}
        {% capture pub_link %}<a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}">Supp</a>{% endcapture %}
      {% endif %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}
    {% if entry.blog %}
      {% capture pub_link %}<a href="{{ entry.blog }}">Blog</a>{% endcapture %}
      {% assign pub_links = pub_links | push: pub_link %}
    {% endif %}

    {%- comment -%}
      The bullet is glued to the item before it (&nbsp;) and followed by a normal space, so a
      long row wraps after a bullet, never before one.
    {%- endcomment -%}
    {% if pub_links.size > 0 %}
      <div class="pub-entry__links">
        {{- pub_links | join: '&nbsp;<span class="pub-entry__sep" aria-hidden="true">•</span> ' -}}
      </div>
    {% endif %}

    {% if entry.video and site.enable_video_embedding %}
      <!-- Video panel, opened by the "Video" button above. -->
      <div class="pub-entry__panel abstract hidden">
        {% include video.liquid path=entry.video class="img-fluid rounded" controls=true %}
      </div>
    {% endif %}
  </div>
</div>
