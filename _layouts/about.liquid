---
layout: default
---
{% comment %}
  Homepage. Content lives in _pages/about.md front matter:
    eyebrow   list of { text, url } shown above the name
    hero      { image, alt, video, poster } — site-root paths
    research  { title, lead, cards: [{ title, text, url }] } — lead is the one-sentence research summary
    social    true → one row of icon + label links (CV, Scholar, GitHub, LinkedIn, Email, ORCID, WeChat)
  The Markdown body of about.md is the short bio.
{% endcomment %}
<div class="home-v2">
  <section class="home-v2-hero" aria-labelledby="home-v2-name">
    <div class="home-v2-hero__text">
      {% if page.eyebrow %}
        <p class="eyebrow home-v2-eyebrow">
          {%- for item in page.eyebrow -%}
            {%- if item.url -%}
              <a href="{{ item.url }}">{{ item.text }}</a>
            {%- else -%}
              {{ item.text }}
            {%- endif -%}
            {%- unless forloop.last -%}
              <span class="home-v2-eyebrow__sep" aria-hidden="true"> · </span>
            {%- endunless -%}
          {%- endfor -%}
        </p>
      {% endif %}

      <h1 class="home-v2-name" id="home-v2-name">
        {%- if site.title == 'blank' -%}
          {{ site.first_name }}
          {% if site.middle_name %}{{ site.middle_name }} {% endif %}
          {{- site.last_name -}}
        {%- else -%}
          {{ site.title }}
        {%- endif -%}
      </h1>

      <div class="home-v2-bio">{{ content }}</div>

      {% if page.social %}
        {%- comment -%}
          One row, one structure: every item is an icon + label link with the same class, so a
          single flex gap spaces them evenly. The WeChat link keeps its QR modal right after it.
        {%- endcomment -%}
        <div class="home-v2-links">
          {%
            include social.liquid
            keys='cv,scholar,github,linkedin,email,orcid,wechat'
            labels=true
            link_class='home-v2-link'
            cv_icon='fa-solid fa-file-lines'
          %}
        </div>
      {% endif %}

      {% if site.newsletter.enabled and site.footer_fixed %}
        {% include scripts/newsletter.liquid %}
      {% endif %}
    </div>

    {% assign hero = page.hero %}
    {% if hero.image != blank or hero.video != blank %}
      <div class="home-v2-media">
        {% if hero.video != blank %}
          {% assign hero_poster = hero.poster | default: hero.image %}
          {% assign hero_video_ext = hero.video | split: '.' | last | downcase %}
          <video
            class="home-v2-media__video"
            width="960"
            height="960"
            muted
            loop
            playsinline
            autoplay
            preload="metadata"
            {% if hero_poster != blank %}
              poster="{{ hero_poster | relative_url }}"
            {% endif %}
            {% if hero.alt %}
              aria-label="{{ hero.alt | escape }}"
            {% endif %}
          >
            <source src="{{ hero.video | relative_url }}" type="video/{% if hero_video_ext == 'webm' %}webm{% else %}mp4{% endif %}">
          </video>
          <script>
            (() => {
              const video = document.currentScript.previousElementSibling;
              const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              if (!video || !reduce) return;
              video.removeAttribute('autoplay');
              video.autoplay = false;
              video.pause();
              video.controls = true;
            })();
          </script>
        {% else %}
          {%
            include figure.liquid
            path=hero.image
            class="home-v2-media__img"
            width="960"
            height="960"
            sizes="(min-width: 992px) 320px, 280px"
            alt=hero.alt
            loading="eager"
            fetchpriority="high"
          %}
        {% endif %}
      </div>
    {% endif %}
  </section>

  {% if page.research.cards %}
    <section class="home-v2-section home-v2-research" aria-labelledby="home-v2-research-title">
      <h2 class="home-v2-section__title" id="home-v2-research-title">
        <a href="{{ '/research/' | relative_url }}">{{ page.research.title | default: 'Research' }}</a>
      </h2>
      {% if page.research.lead %}
        <p class="home-v2-lead">{{ page.research.lead }}</p>
      {% endif %}
      <ul class="home-v2-cards">
        {% for card in page.research.cards %}
          <li>
            <a class="hairline-card home-v2-card" href="{{ card.url | relative_url }}">
              <h3 class="home-v2-card__title">
                {{ card.title -}}
                <span class="home-v2-card__arrow" aria-hidden="true">→</span>
              </h3>
              <p class="home-v2-card__text">{{ card.text }}</p>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-v2-section selected-publications" aria-labelledby="home-v2-pubs-title">
      <h2 class="home-v2-section__title" id="home-v2-pubs-title">Selected publications</h2>
      {% include selected_papers.liquid %}
      <p class="home-v2-more">
        <a href="{{ '/publications/' | relative_url }}">All publications<span aria-hidden="true">&nbsp;→</span></a>
      </p>
    </section>
  {% endif %}

  {% if page.news and site.announcements.enabled %}
    <section class="home-v2-section home-v2-news" aria-labelledby="home-v2-news-title">
      <h2 class="home-v2-section__title" id="home-v2-news-title">
        <a href="{{ '/news/' | relative_url }}">News</a>
      </h2>
      {% include news.liquid limit=3 %}
    </section>
  {% endif %}
</div>
