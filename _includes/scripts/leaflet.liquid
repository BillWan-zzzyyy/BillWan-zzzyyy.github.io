{% if page.map %}
  <script
    src="{{ site.third_party_libraries.leaflet.url.js }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  <script>
    /* Create leaflet map as another node and hide the code block, appending the leaflet node after it */
    document.addEventListener('readystatechange', () => {
      if (document.readyState === 'complete') {
        document.querySelectorAll('pre>code.language-geojson').forEach((elem) => {
          const jsonData = elem.textContent;
          const backup = elem.parentElement;
          backup.classList.add('unloaded');
          /* create leaflet node */
          let mapElement = document.createElement('div');
          mapElement.classList.add('map');
          backup.after(mapElement);

          var map = L.map(mapElement, { scrollWheelZoom: false });
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(map);
          let geoJSON = L.geoJSON(JSON.parse(jsonData), {
            /* Points render as themed circle markers; `lived: true` gets the accent class */
            pointToLayer: (feature, latlng) =>
              L.circleMarker(latlng, {
                radius: 6,
                className: feature.properties && feature.properties.lived ? 'map-pin map-pin--lived' : 'map-pin',
              }),
            /* Popup "name · years", built with textContent so no HTML is injected */
            onEachFeature: (feature, layer) => {
              const props = feature.properties;
              if (props && props.name) {
                const popup = document.createElement('span');
                popup.textContent = props.years ? `${props.name} · ${props.years}` : String(props.name);
                layer.bindPopup(popup);
              }
            },
          }).addTo(map);
          map.fitBounds(geoJSON.getBounds(), { padding: [20, 20] });
        });
      }
    });
  </script>
{% endif %}
