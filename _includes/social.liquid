{% comment %}
  Social / contact links built from the handles in _config.yml.

  Parameters (all optional):
    keys        comma-separated networks to render, in that order (default: all, in the order below)
    exclude     comma-separated networks to skip
    labels      true → print a short text label after the icon
    link_class  class added to every <a>
    cv_icon     icon classes for the CV link (default: the academicons "CV" glyph)
    text_only   true → plain text links: the label only, no icon (implies labels)
    separator   text printed after every link, e.g. '/' → "Email / CV / Scholar".
                It is glued to the link with a no-break space, so lines wrap after it;
                hide the trailing one with `.social-sep:last-child { display: none; }`.

  With no parameters it renders one icon link per configured network (navbar usage).
{% endcomment %}
{% assign social_default_keys = 'email,cv,telegram,whatsapp,scholar,orcid,inspirehep,semanticscholar,publons,lattes,osf,researchgate,ieee,acm,scopus,github,linkedin,x,mastodon,medium,quora,flickr,blogger,work,wikidata,wikipedia,strava,keybase,gitlab,dblp,stackoverflow,kaggle,lastfm,spotify,pinterest,unsplash,instagram,facebook,bluesky,youtube,discord,zotero,rss,wechat' %}
{% assign social_keys = include.keys | default: social_default_keys | split: ',' %}
{% assign social_exclude = include.exclude | default: '' | split: ',' %}
{% assign social_class = include.link_class | default: '' %}

{% for social_key in social_keys %}
  {% if social_exclude contains social_key %}
    {% continue %}
  {% endif %}

  {% assign s_href = '' %}
  {% assign s_title = '' %}
  {% assign s_label = '' %}
  {% assign s_icon = '' %}
  {% assign s_attrs = '' %}

  {% case social_key %}
    {% when 'email' %}
      {% if site.email %}
        {% assign s_href = site.email | encode_email | prepend: 'mailto:' %}
        {% assign s_title = 'email' %}
        {% assign s_label = 'Email' %}
        {% assign s_icon = 'fa-solid fa-envelope' %}
      {% endif %}
    {% when 'cv' %}
      {% if site.cv_pdf %}
        {% assign s_href = site.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
        {% assign s_title = 'CV' %}
        {% assign s_label = 'CV' %}
        {% assign s_icon = include.cv_icon | default: 'ai ai-cv' %}
        {% assign s_attrs = 'target="_blank" rel="noopener noreferrer"' %}
      {% endif %}
    {% when 'telegram' %}
      {% if site.telegram_username %}
        {% assign s_href = site.telegram_username | prepend: 'https://telegram.me/' %}
        {% assign s_title = 'telegram' %}
        {% assign s_label = 'Telegram' %}
        {% assign s_icon = 'fa-brands fa-telegram' %}
      {% endif %}
    {% when 'whatsapp' %}
      {% if site.whatsapp_number %}
        {% assign s_href = site.whatsapp_number | prepend: 'https://wa.me/' %}
        {% assign s_title = 'whatsapp' %}
        {% assign s_label = 'WhatsApp' %}
        {% assign s_icon = 'fa-brands fa-whatsapp' %}
      {% endif %}
    {% when 'scholar' %}
      {% if site.scholar_userid %}
        {% assign s_href = site.scholar_userid | prepend: 'https://scholar.google.com/citations?user=' %}
        {% assign s_title = 'Google Scholar' %}
        {% assign s_label = 'Scholar' %}
        {% assign s_icon = 'ai ai-google-scholar' %}
      {% endif %}
    {% when 'orcid' %}
      {% if site.orcid_id %}
        {% assign s_href = site.orcid_id | prepend: 'https://orcid.org/' %}
        {% assign s_title = 'ORCID' %}
        {% assign s_label = 'ORCID' %}
        {% assign s_icon = 'ai ai-orcid' %}
      {% endif %}
    {% when 'inspirehep' %}
      {% if site.inspirehep_id %}
        {% assign s_href = site.inspirehep_id | prepend: 'https://inspirehep.net/authors/' %}
        {% assign s_title = 'Inspire HEP' %}
        {% assign s_label = 'Inspire HEP' %}
        {% assign s_icon = 'ai ai-inspire' %}
      {% endif %}
    {% when 'semanticscholar' %}
      {% if site.semanticscholar_id %}
        {% assign s_href = site.semanticscholar_id | prepend: 'https://www.semanticscholar.org/author/' %}
        {% assign s_title = 'Semantic Scholar' %}
        {% assign s_label = 'Semantic Scholar' %}
        {% assign s_icon = 'ai ai-semantic-scholar' %}
      {% endif %}
    {% when 'publons' %}
      {% if site.publons_id %}
        {% assign s_href = site.publons_id | prepend: 'https://publons.com/a/' | append: '/' %}
        {% assign s_title = 'Publons' %}
        {% assign s_label = 'Publons' %}
        {% assign s_icon = 'ai ai-publons' %}
      {% endif %}
    {% when 'lattes' %}
      {% if site.lattes_id %}
        {% assign s_href = site.lattes_id | prepend: 'http://lattes.cnpq.br/' %}
        {% assign s_title = 'Lattes' %}
        {% assign s_label = 'Lattes' %}
        {% assign s_icon = 'ai ai-lattes' %}
        {% assign s_attrs = 'target="_blank"' %}
      {% endif %}
    {% when 'osf' %}
      {% if site.osf_id %}
        {% assign s_href = site.osf_id | prepend: 'https://osf.io/' | append: '/' %}
        {% assign s_title = 'Open Science Framework' %}
        {% assign s_label = 'OSF' %}
        {% assign s_icon = 'ai ai-osf' %}
      {% endif %}
    {% when 'researchgate' %}
      {% if site.research_gate_profile %}
        {% assign s_href = site.research_gate_profile | prepend: 'https://www.researchgate.net/profile/' | append: '/' %}
        {% assign s_title = 'ResearchGate' %}
        {% assign s_label = 'ResearchGate' %}
        {% assign s_icon = 'ai ai-researchgate' %}
      {% endif %}
    {% when 'ieee' %}
      {% if site.ieee_id %}
        {% assign s_href = site.ieee_id | prepend: 'https://ieeexplore.ieee.org/author/' | append: '/' %}
        {% assign s_title = 'IEEE Xplore' %}
        {% assign s_label = 'IEEE Xplore' %}
        {% assign s_icon = 'ai ai-ieee' %}
      {% endif %}
    {% when 'acm' %}
      {% if site.acm_id %}
        {% assign s_href = site.acm_id | prepend: 'https://dl.acm.org/profile/' | append: '/' %}
        {% assign s_title = 'ACM DL' %}
        {% assign s_label = 'ACM DL' %}
        {% assign s_icon = 'ai ai-acm' %}
      {% endif %}
    {% when 'scopus' %}
      {% if site.scopus_id %}
        {% assign s_href = site.scopus_id | prepend: 'https://www.scopus.com/authid/detail.uri?authorId=' %}
        {% assign s_title = 'Scopus' %}
        {% assign s_label = 'Scopus' %}
        {% assign s_icon = 'ai ai-scopus' %}
      {% endif %}
    {% when 'github' %}
      {% if site.github_username %}
        {% assign s_href = site.github_username | prepend: 'https://github.com/' %}
        {% assign s_title = 'GitHub' %}
        {% assign s_label = 'GitHub' %}
        {% assign s_icon = 'fa-brands fa-github' %}
      {% endif %}
    {% when 'linkedin' %}
      {% if site.linkedin_username %}
        {% assign s_href = site.linkedin_username | prepend: 'https://www.linkedin.com/in/' %}
        {% assign s_title = 'LinkedIn' %}
        {% assign s_label = 'LinkedIn' %}
        {% assign s_icon = 'fa-brands fa-linkedin' %}
      {% endif %}
    {% when 'x' %}
      {% if site.x_username %}
        {% assign s_href = site.x_username | prepend: 'https://twitter.com/' %}
        {% assign s_title = 'X' %}
        {% assign s_label = 'X' %}
        {% assign s_icon = 'fa-brands fa-x-twitter' %}
      {% endif %}
    {% when 'mastodon' %}
      {% if site.mastodon_username %}
        {% assign s_href = site.mastodon_username | prepend: 'https://' %}
        {% assign s_title = 'Mastodon' %}
        {% assign s_label = 'Mastodon' %}
        {% assign s_icon = 'fa-brands fa-mastodon' %}
        {% assign s_attrs = 'rel="me"' %}
      {% endif %}
    {% when 'medium' %}
      {% if site.medium_username %}
        {% assign s_href = site.medium_username | prepend: 'https://medium.com/@' %}
        {% assign s_title = 'Medium' %}
        {% assign s_label = 'Medium' %}
        {% assign s_icon = 'fa-brands fa-medium' %}
      {% endif %}
    {% when 'quora' %}
      {% if site.quora_username %}
        {% assign s_href = site.quora_username | prepend: 'https://www.quora.com/profile/' %}
        {% assign s_title = 'Quora' %}
        {% assign s_label = 'Quora' %}
        {% assign s_icon = 'fa-brands fa-quora' %}
      {% endif %}
    {% when 'flickr' %}
      {% if site.flickr_id %}
        {% assign s_href = site.flickr_id | prepend: 'https://www.flickr.com/' %}
        {% assign s_title = 'Flickr' %}
        {% assign s_label = 'Flickr' %}
        {% assign s_icon = 'fa-brands fa-flickr' %}
      {% endif %}
    {% when 'blogger' %}
      {% if site.blogger_url %}
        {% assign s_href = site.blogger_url %}
        {% assign s_title = 'Blogger' %}
        {% assign s_label = 'Blogger' %}
        {% assign s_icon = 'fa-brands fa-blogger-b' %}
      {% endif %}
    {% when 'work' %}
      {% if site.work_url %}
        {% assign s_href = site.work_url %}
        {% assign s_title = 'Work' %}
        {% assign s_label = 'Work' %}
        {% assign s_icon = 'fa-solid fa-briefcase' %}
      {% endif %}
    {% when 'wikidata' %}
      {% if site.wikidata_id %}
        {% assign s_href = site.wikidata_id | prepend: 'https://www.wikidata.org/wiki/' %}
        {% assign s_title = 'Wikidata' %}
        {% assign s_label = 'Wikidata' %}
        {% assign s_icon = 'fa-solid fa-barcode' %}
      {% endif %}
    {% when 'wikipedia' %}
      {% if site.wikipedia_id %}
        {% assign s_href = site.wikipedia_id | prepend: 'https://wikipedia.org/wiki/User:' %}
        {% assign s_title = 'Wikipedia' %}
        {% assign s_label = 'Wikipedia' %}
        {% assign s_icon = 'fa-brands fa-wikipedia-w' %}
      {% endif %}
    {% when 'strava' %}
      {% if site.strava_userid %}
        {% assign s_href = site.strava_userid | prepend: 'https://www.strava.com/athletes/' %}
        {% assign s_title = 'Strava' %}
        {% assign s_label = 'Strava' %}
        {% assign s_icon = 'fa-brands fa-strava' %}
      {% endif %}
    {% when 'keybase' %}
      {% if site.keybase_username %}
        {% assign s_href = site.keybase_username | prepend: 'https://keybase.io/' %}
        {% assign s_title = 'Keybase' %}
        {% assign s_label = 'Keybase' %}
        {% assign s_icon = 'fa-brands fa-keybase' %}
      {% endif %}
    {% when 'gitlab' %}
      {% if site.gitlab_username %}
        {% assign s_href = site.gitlab_username | prepend: 'https://gitlab.com/' %}
        {% assign s_title = 'GitLab' %}
        {% assign s_label = 'GitLab' %}
        {% assign s_icon = 'fa-brands fa-gitlab' %}
      {% endif %}
    {% when 'dblp' %}
      {% if site.dblp_url %}
        {% assign s_href = site.dblp_url %}
        {% assign s_title = 'DBLP' %}
        {% assign s_label = 'DBLP' %}
        {% assign s_icon = 'ai ai-dblp' %}
      {% endif %}
    {% when 'stackoverflow' %}
      {% if site.stackoverflow_id %}
        {% assign s_href = site.stackoverflow_id | prepend: 'https://stackoverflow.com/users/' %}
        {% assign s_title = 'Stackoverflow' %}
        {% assign s_label = 'Stack Overflow' %}
        {% assign s_icon = 'fa-brands fa-stack-overflow' %}
      {% endif %}
    {% when 'kaggle' %}
      {% if site.kaggle_id %}
        {% assign s_href = site.kaggle_id | prepend: 'https://www.kaggle.com/' %}
        {% assign s_title = 'Kaggle' %}
        {% assign s_label = 'Kaggle' %}
        {% assign s_icon = 'fa-brands fa-kaggle' %}
      {% endif %}
    {% when 'lastfm' %}
      {% if site.lastfm_id %}
        {% assign s_href = site.lastfm_id | prepend: 'https://www.last.fm/user/' %}
        {% assign s_title = 'Last FM' %}
        {% assign s_label = 'Last.fm' %}
        {% assign s_icon = 'fa-brands fa-lastfm' %}
      {% endif %}
    {% when 'spotify' %}
      {% if site.spotify_id %}
        {% assign s_href = site.spotify_id | prepend: 'https://open.spotify.com/user/' %}
        {% assign s_title = 'Spotify' %}
        {% assign s_label = 'Spotify' %}
        {% assign s_icon = 'fa-brands fa-spotify' %}
      {% endif %}
    {% when 'pinterest' %}
      {% if site.pinterest_id %}
        {% assign s_href = site.pinterest_id | prepend: 'https://www.pinterest.com/' %}
        {% assign s_title = 'Pinterest' %}
        {% assign s_label = 'Pinterest' %}
        {% assign s_icon = 'fa-brands fa-pinterest' %}
      {% endif %}
    {% when 'unsplash' %}
      {% if site.unsplash_id %}
        {% assign s_href = site.unsplash_id | prepend: 'https://unsplash.com/@' %}
        {% assign s_title = 'Unsplash' %}
        {% assign s_label = 'Unsplash' %}
        {% assign s_icon = 'fa-brands fa-unsplash' %}
      {% endif %}
    {% when 'instagram' %}
      {% if site.instagram_id %}
        {% assign s_href = site.instagram_id | prepend: 'https://instagram.com/' %}
        {% assign s_title = 'Instagram' %}
        {% assign s_label = 'Instagram' %}
        {% assign s_icon = 'fa-brands fa-instagram' %}
      {% endif %}
    {% when 'facebook' %}
      {% if site.facebook_id %}
        {% assign s_href = site.facebook_id | prepend: 'https://facebook.com/' %}
        {% assign s_title = 'Facebook' %}
        {% assign s_label = 'Facebook' %}
        {% assign s_icon = 'fa-brands fa-facebook' %}
      {% endif %}
    {% when 'bluesky' %}
      {% if site.bluesky_url %}
        {% assign s_href = site.bluesky_url %}
        {% assign s_title = 'Bluesky' %}
        {% assign s_label = 'Bluesky' %}
        {% assign s_icon = 'fa-brands fa-bluesky' %}
      {% endif %}
    {% when 'youtube' %}
      {% if site.youtube_id %}
        {% assign s_href = site.youtube_id | prepend: 'https://youtube.com/@' %}
        {% assign s_title = 'YouTube' %}
        {% assign s_label = 'YouTube' %}
        {% assign s_icon = 'fa-brands fa-youtube' %}
      {% endif %}
    {% when 'discord' %}
      {% if site.discord_id %}
        {% assign s_href = site.discord_id | prepend: 'https://discord.com/users/' %}
        {% assign s_title = 'Discord' %}
        {% assign s_label = 'Discord' %}
        {% assign s_icon = 'fa-brands fa-discord' %}
      {% endif %}
    {% when 'zotero' %}
      {% if site.zotero_username %}
        {% assign s_href = site.zotero_username | prepend: 'https://www.zotero.org/' %}
        {% assign s_title = 'Zotero' %}
        {% assign s_label = 'Zotero' %}
        {% assign s_icon = 'ai ai-zotero' %}
      {% endif %}
    {% when 'rss' %}
      {% if site.rss_icon %}
        {% assign s_href = site.baseurl | append: '/feed.xml' %}
        {% assign s_title = 'RSS Feed' %}
        {% assign s_label = 'RSS' %}
        {% assign s_icon = 'fa-solid fa-square-rss' %}
      {% endif %}
    {% when 'wechat' %}
      {% comment %} The trigger must stay immediately before its modal (see scripts/wechatModal.liquid). {% endcomment %}
      {% if site.wechat_qr %}
        {% assign wechat_qr_path = site.wechat_qr | prepend: 'assets/img/' | relative_url %}
        <a
          class="wechat-trigger{% if social_class != '' %} {{ social_class }}{% endif %}"
          href="{{ wechat_qr_path }}"
          title="WeChat"
          aria-label="Show WeChat QR code"
          aria-haspopup="dialog"
          aria-expanded="false"
          data-wechat-trigger
        >
          {%- if include.text_only -%}
            WeChat
          {%- else -%}
            <i aria-hidden="true" class="fa-brands fa-weixin"></i>
            {%- if include.labels -%}
              WeChat
            {%- endif -%}
          {%- endif -%}
        </a>
        <div
          class="wechat-modal"
          role="dialog"
          aria-modal="true"
          aria-label="WeChat QR code"
          aria-hidden="true"
          tabindex="-1"
          data-wechat-modal
          hidden
        >
          <button class="wechat-modal__close" type="button" aria-label="Close WeChat QR code" data-wechat-close>&times;</button>
          <img class="wechat-modal__qr" src="{{ wechat_qr_path }}" alt="Scan this QR code to connect on WeChat">
        </div>
        {% include scripts/wechatModal.liquid %}
        {%- if include.separator -%}
          <span class="social-sep" aria-hidden="true">&nbsp;{{ include.separator }}</span>
        {%- endif %}
      {% endif %}
  {% endcase %}

  {% if s_href != '' %}
    <a
      {% if social_class != '' %}
        class="{{ social_class }}"
      {% endif %}
      href="{{ s_href }}"
      title="{{ s_title }}"
      {% unless include.text_only %}
        aria-label="{{ s_title }}"
      {% endunless %}
      {{ s_attrs }}
    >
      {%- if include.text_only -%}
        {{ s_label }}
      {%- else -%}
        <i aria-hidden="true" class="{{ s_icon }}"></i>
        {%- if include.labels -%}
          {{ s_label }}
        {%- endif -%}
      {%- endif -%}
    </a>
    {%- if include.separator -%}
      <span class="social-sep" aria-hidden="true">&nbsp;{{ include.separator }}</span>
    {%- endif %}
  {% endif %}
{% endfor %}
