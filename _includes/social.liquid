{% if site.email %}
  <a href="mailto:{{ site.email | encode_email }}" title="email" aria-label="email"><i aria-hidden="true" class="fa-solid fa-envelope"></i></a>
{% endif %}
{% if site.cv_pdf %}
  <a href="{{ site.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" title="CV" aria-label="CV" target="_blank" rel="noopener noreferrer"
    ><i aria-hidden="true" class="ai ai-cv"></i
  ></a>
{% endif %}
{% if site.telegram_username %}
  <a href="https://telegram.me/{{ site.telegram_username }}" title="telegram" aria-label="telegram"
    ><i aria-hidden="true" class="fa-brands fa-telegram"></i
  ></a>
{% endif %}
{% if site.whatsapp_number %}
  <a href="https://wa.me/{{ site.whatsapp_number }}" title="whatsapp" aria-label="whatsapp"
    ><i aria-hidden="true" class="fa-brands fa-whatsapp"></i
  ></a>
{% endif %}
{% if site.scholar_userid %}
  <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" title="Google Scholar" aria-label="Google Scholar"
    ><i aria-hidden="true" class="ai ai-google-scholar"></i
  ></a>
{% endif %}
{% if site.orcid_id %}
  <a href="https://orcid.org/{{ site.orcid_id }}" title="ORCID" aria-label="ORCID"><i aria-hidden="true" class="ai ai-orcid"></i></a>
{% endif %}
{% if site.inspirehep_id %}
  <a href="https://inspirehep.net/authors/{{ site.inspirehep_id }}" title="Inspire HEP" aria-label="Inspire HEP"
    ><i aria-hidden="true" class="ai ai-inspire"></i
  ></a>
{% endif %}
{% if site.semanticscholar_id %}
  <a href="https://www.semanticscholar.org/author/{{ site.semanticscholar_id }}" title="Semantic Scholar" aria-label="Semantic Scholar"
