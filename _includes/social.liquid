  ></a>
{% endif %}
{% if site.unsplash_id %}
  <a href="https://unsplash.com/@{{ site.unsplash_id }}" title="Unsplash" aria-label="Unsplash"
    ><i aria-hidden="true" class="fa-brands fa-unsplash"></i
  ></a>
{% endif %}
{% if site.instagram_id %}
  <a href="https://instagram.com/{{ site.instagram_id }}" title="Instagram" aria-label="Instagram"
    ><i aria-hidden="true" class="fa-brands fa-instagram"></i
  ></a>
{% endif %}
{% if site.facebook_id %}
  <a href="https://facebook.com/{{ site.facebook_id }}" title="Facebook" aria-label="Facebook"
    ><i aria-hidden="true" class="fa-brands fa-facebook"></i
  ></a>
{% endif %}
{% if site.bluesky_url %}
  <a href="{{ site.bluesky_url }}" title="Bluesky" aria-label="Bluesky"><i aria-hidden="true" class="fa-brands fa-bluesky"></i></a>
{% endif %}
{% if site.youtube_id %}
  <a href="https://youtube.com/@{{ site.youtube_id }}" title="YouTube" aria-label="YouTube"
    ><i aria-hidden="true" class="fa-brands fa-youtube"></i
  ></a>
{% endif %}
{% if site.discord_id %}
  <a href="https://discord.com/users/{{ site.discord_id }}" title="Discord" aria-label="Discord"
    ><i aria-hidden="true" class="fa-brands fa-discord"></i
  ></a>
{% endif %}
{% if site.zotero_username %}
  <a href="https://www.zotero.org/{{ site.zotero_username }}" title="Zotero" aria-label="Zotero"><i aria-hidden="true" class="ai ai-zotero"></i></a>
{% endif %}
{% if site.rss_icon %}
  <a href="{{ site.baseurl }}/feed.xml" title="RSS Feed" aria-label="RSS Feed"><i aria-hidden="true" class="fa-solid fa-square-rss"></i></a>
{% endif %}
{% if site.wechat_qr %}
  {% assign wechat_qr_path = site.wechat_qr | prepend: 'assets/img/' | relative_url %}
  <a
    class="wechat-trigger"
    href="{{ wechat_qr_path }}"
    title="WeChat"
    aria-label="Show WeChat QR code"
    aria-haspopup="dialog"
    aria-expanded="false"
    data-wechat-trigger
    ><i aria-hidden="true" class="fa-brands fa-weixin"></i
  ></a>
  <div
    class="wechat-modal"
    role="dialog"
    aria-modal="true"
    aria-label="WeChat QR code"
    aria-hidden="true"
    tabindex="-1"
    data-wechat-modal
    hidden
  >
    <button class="wechat-modal__close" type="button" aria-label="Close WeChat QR code" data-wechat-close>&times;</button>
    <img class="wechat-modal__qr" src="{{ wechat_qr_path }}" alt="Scan this QR code to connect on WeChat">
  </div>
  {% include scripts/wechatModal.liquid %}
{% endif %}
